# Vercel AI Gateway API key (get one at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys)
# Not needed if deployed on Vercel with OIDC.
AI_GATEWAY_API_KEY=

# Etherscan API key (free at https://etherscan.io/apis) — powers live contract
# verification checks in the risk-analysis tool, via Etherscan's unified v2 API
# (covers Ethereum, BSC, Polygon, Arbitrum, Base, Optimism, Avalanche).
ETHERSCAN_API_KEY=

# X (Twitter) API Bearer Token — app-only read auth from console.x.com's
# "Keys & Tokens" tab (App-Only Authentication section). Powers live account
# age/follower-ratio/activity checks in the twitter-genuineness tool.
X_API_BEARER_TOKEN=

# Upstash Redis (provision via Vercel Marketplace) — backs the premium-check
# usage counter used by the reward mechanic below.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# SteemieToken (ERC-20 on X Layer) reward distribution. Leave
# STEEMIE_TOKEN_ADDRESS unset to disable rewards (e.g. before the mainnet
# contract is deployed) — sendReward() no-ops safely when it's missing.
STEEMIE_TOKEN_ADDRESS=
REWARD_DISTRIBUTOR_PRIVATE_KEY=
# "mainnet" (default, matches the x402 payment network) or "testnet"
STEEMIE_TOKEN_CHAIN=mainnet
REWARD_AMOUNT_STEEM=10000
